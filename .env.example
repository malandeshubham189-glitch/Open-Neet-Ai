# GOOGLE_AI_API_KEY: Primary key for Google AI Studio / Gemini API.
# AI Studio automatically injects GEMINI_API_KEY or GOOGLE_AI_API_KEY at runtime.
GOOGLE_AI_API_KEY=""
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Configurable Gemini Models (Supports gemini-2.5-pro, gemini-2.5-flash, etc.)
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key for importing official lectures
YOUTUBE_API_KEY=""
