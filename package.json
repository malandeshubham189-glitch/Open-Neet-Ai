{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "build:lectures": "tsx src/scripts/buildLectureDatabase.ts",
    "verify:lectures": "tsx src/scripts/verifyLectureDatabase.ts",
    "sync:botany11": "tsx src/scripts/syncBotany11.ts",
    "verify:botany11": "tsx src/scripts/verifyBotany11.ts",
    "verify:liveclass": "tsx src/scripts/verifyLiveClass.ts",
    "verify:unacademy": "tsx src/scripts/verifyUnacademyPipeline.ts",
    "verify:liveresolver": "tsx src/scripts/verifyLiveResolver.ts",
    "verify:youtubesystem": "tsx src/scripts/verifyYouTubeSystem.ts",
    "verify:engine": "tsx src/scripts/verifyEngineAndYouTube.ts",
    "verify:aitutor": "tsx src/scripts/verifyAITutorMode.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "msedge-tts": "^2.0.7",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
